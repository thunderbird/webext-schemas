[
    {
        "annotations": [
            {
                "text": "The permissions API allows to manage optional permissions at runtime."
            },
            {
                "mdn_documentation_url": "https://developer.mozilla.org/docs/Mozilla/Add-ons/WebExtensions/API/permissions"
            },
            {
                "version_added": "55"
            }
        ],
        "events": [
            {
                "annotations": [
                    {
                        "mdn_documentation_url": "https://developer.mozilla.org/docs/Mozilla/Add-ons/WebExtensions/API/permissions/onAdded"
                    },
                    {
                        "version_added": "77"
                    }
                ],
                "description": "Fired when the extension acquires new permissions.",
                "name": "onAdded",
                "parameters": [
                    {
                        "$ref": "Permissions",
                        "name": "permissions"
                    }
                ],
                "type": "function"
            },
            {
                "annotations": [
                    {
                        "mdn_documentation_url": "https://developer.mozilla.org/docs/Mozilla/Add-ons/WebExtensions/API/permissions/onRemoved"
                    },
                    {
                        "version_added": "77"
                    }
                ],
                "description": "Fired when permissions are removed from the extension.",
                "name": "onRemoved",
                "parameters": [
                    {
                        "$ref": "Permissions",
                        "name": "permissions"
                    }
                ],
                "type": "function"
            }
        ],
        "functions": [
            {
                "annotations": [
                    {
                        "mdn_documentation_url": "https://developer.mozilla.org/docs/Mozilla/Add-ons/WebExtensions/API/permissions/getAll"
                    },
                    {
                        "version_added": "55"
                    }
                ],
                "async": "callback",
                "description": "Get a list of all the extension's permissions.",
                "name": "getAll",
                "parameters": [
                    {
                        "name": "callback",
                        "parameters": [
                            {
                                "$ref": "AnyPermissions",
                                "name": "permissions"
                            }
                        ],
                        "type": "function"
                    }
                ],
                "type": "function"
            },
            {
                "annotations": [
                    {
                        "mdn_documentation_url": "https://developer.mozilla.org/docs/Mozilla/Add-ons/WebExtensions/API/permissions/contains"
                    },
                    {
                        "version_added": "55"
                    }
                ],
                "async": "callback",
                "description": "Check if the extension has the given permissions.",
                "name": "contains",
                "parameters": [
                    {
                        "$ref": "AnyPermissions",
                        "name": "permissions"
                    },
                    {
                        "name": "callback",
                        "parameters": [
                            {
                                "name": "result",
                                "type": "boolean"
                            }
                        ],
                        "type": "function"
                    }
                ],
                "type": "function"
            },
            {
                "allowedContexts": [
                    "content"
                ],
                "annotations": [
                    {
                        "mdn_documentation_url": "https://developer.mozilla.org/docs/Mozilla/Add-ons/WebExtensions/API/permissions/request"
                    },
                    {
                        "bcd": true,
                        "note": "It's not possible to request permissions from within DevTools (<a href=\"https://bugzil.la/1796933\">bug 1796933</a>)."
                    },
                    {
                        "bcd": true,
                        "note": "Before version 101, permissions cannot be requested from a sidebar document (<a href=\"https://bugzil.la/1493396\">bug 1493396</a>)."
                    },
                    {
                        "bcd": true,
                        "note": "Before version 75, permissions cannot be requested from popup panels (see <a href=\"https://bugzil.la/1432083\">bug 1432083</a>)."
                    },
                    {
                        "bcd": true,
                        "note": "Before version 61, permissions cannot be requested from options pages embedded in <code>about:addons</code> (see <a href=\"https://bugzil.la/1382953\">bug 1382953</a>)."
                    },
                    {
                        "version_added": "55"
                    }
                ],
                "async": "callback",
                "description": "Request the given permissions.",
                "name": "request",
                "parameters": [
                    {
                        "$ref": "Permissions",
                        "name": "permissions"
                    },
                    {
                        "name": "callback",
                        "parameters": [
                            {
                                "name": "granted",
                                "type": "boolean"
                            }
                        ],
                        "type": "function"
                    }
                ],
                "requireUserInput": true,
                "type": "function"
            },
            {
                "annotations": [
                    {
                        "mdn_documentation_url": "https://developer.mozilla.org/docs/Mozilla/Add-ons/WebExtensions/API/permissions/remove"
                    },
                    {
                        "version_added": "55"
                    }
                ],
                "async": "callback",
                "description": "Relinquish the given permissions.",
                "name": "remove",
                "parameters": [
                    {
                        "$ref": "Permissions",
                        "name": "permissions"
                    },
                    {
                        "name": "callback",
                        "parameters": [],
                        "type": "function"
                    }
                ],
                "type": "function"
            }
        ],
        "namespace": "permissions",
        "types": [
            {
                "annotations": [
                    {
                        "mdn_documentation_url": "https://developer.mozilla.org/docs/Mozilla/Add-ons/WebExtensions/API/permissions/Permissions"
                    },
                    {
                        "version_added": "55"
                    }
                ],
                "id": "Permissions",
                "properties": {
                    "data_collection": {
                        "default": [],
                        "items": {
                            "$ref": "manifest.OptionalDataCollectionPermission"
                        },
                        "optional": true,
                        "type": "array"
                    },
                    "origins": {
                        "default": [],
                        "items": {
                            "$ref": "manifest.MatchPattern"
                        },
                        "optional": true,
                        "type": "array"
                    },
                    "permissions": {
                        "default": [],
                        "items": {
                            "choices": [
                                {
                                    "$ref": "manifest.OptionalPermission"
                                },
                                {
                                    "$ref": "manifest.OptionalOnlyPermission"
                                }
                            ]
                        },
                        "optional": true,
                        "type": "array"
                    }
                },
                "type": "object"
            },
            {
                "id": "AnyPermissions",
                "properties": {
                    "data_collection": {
                        "default": [],
                        "items": {
                            "$ref": "manifest.OptionalDataCollectionPermission"
                        },
                        "optional": true,
                        "type": "array"
                    },
                    "origins": {
                        "default": [],
                        "items": {
                            "$ref": "manifest.MatchPattern"
                        },
                        "optional": true,
                        "type": "array"
                    },
                    "permissions": {
                        "default": [],
                        "items": {
                            "choices": [
                                {
                                    "$ref": "manifest.Permission"
                                },
                                {
                                    "$ref": "manifest.OptionalOnlyPermission"
                                }
                            ]
                        },
                        "optional": true,
                        "type": "array"
                    }
                },
                "type": "object"
            }
        ]
    },
    {
        "applicationVersion": "155.0.1",
        "namespace": "manifest"
    }
]