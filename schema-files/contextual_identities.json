                        "type": "object"
                    },
                    {
                        "name": "callback",
                        "parameters": [
                            {
                                "$ref": "SiteAssociation",
                                "description": "The association of the site, null if the site is not associated with any container.",
                                "name": "association",
                                "optional": true
                            }
                        ],
                        "type": "function"
                    }
                ],
                "type": "function"
            },
            {
                "async": "callback",
                "description": "Retrieves the list of site-to-container associations.",
