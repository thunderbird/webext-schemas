                            "icon": {
                                "description": "The icon of the contextual identity.",
                                "optional": true,
                                "type": "string"
                            },
                            "name": {
                                "description": "The name of the contextual identity.",
                                "optional": true,
                                "type": "string"
                            }
                        },
                        "type": "object"
                    }
