            {
                "description": "Represents the association between a site and a contextual identity.",
                "id": "SiteAssociation",
                "properties": {
                    "cookieStoreId": {
                        "description": "The cookie store ID of the contextual identity the host is associated with.",
                        "type": "string"
                    },
                    "site": {
                        "description": "The associated host, normalized to lower case and encoded as ASCII.",
                        "type": "string"
                    }
                },
                "type": "object"
            }
        ]
    }
