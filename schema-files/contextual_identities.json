                    {
                        "name": "callback",
                        "parameters": [
                            {
                                "description": "The site-to-container associations.",
                                "items": {
                                    "$ref": "SiteAssociation"
                                },
                                "name": "associations",
                                "type": "array"
                            }
                        ],
                        "type": "function"
                    }
                ],
                "type": "function"
            }
