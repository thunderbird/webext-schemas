                "parameters": [
                    {
                        "description": "Details about the site association.",
                        "name": "details",
                        "properties": {
                            "cookieStoreId": {
                                "description": "The cookie store ID of the container to associate the site with.",
                                "type": "string"
                            },
                            "site": {
                                "description": "The host to associate with the container (matched as an exact host).",
                                "type": "string"
                            }
                        },
                        "type": "object"
                    }
                ],
                "type": "function"
            },
            {
                "async": true,
                "description": "Removes the container association for a site.",
