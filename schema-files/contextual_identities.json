                "parameters": [
                    {
                        "description": "Details about the site association to remove.",
                        "name": "details",
                        "properties": {
                            "site": {
                                "description": "The host whose container association should be removed.",
                                "type": "string"
                            }
                        },
                        "type": "object"
                    }
                ],
                "type": "function"
            },
            {
                "async": "callback",
