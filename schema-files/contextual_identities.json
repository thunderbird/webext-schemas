                "annotations": [
                    {
                        "mdn_documentation_url": "https://developer.mozilla.org/docs/Mozilla/Add-ons/WebExtensions/API/contextualIdentities/update"
                    },
                    {
                        "bcd": true,
                        "note": "Before version 57, this method resolves its promise with <code>false</code> if the contextual identities feature is disabled."
