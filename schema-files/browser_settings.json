[
    {
        "applicationVersion": "155.0.1",
        "namespace": "manifest",
        "types": [
            {
                "$extend": "OptionalPermission",
                "choices": [
                    {
                        "enum": [
                            "browserSettings"
                        ],
                        "enums": {
                            "browserSettings": {
                                "annotations": [
                                    {
                                        "version_added": true
                                    }
                                ]
                            }
                        },
                        "type": "string"
                    }
                ]
            }
        ]
    },
    {
        "annotations": [
            {
                "mdn_documentation_url": "https://developer.mozilla.org/docs/Mozilla/Add-ons/WebExtensions/API/browserSettings"
            },
            {
                "version_added": "56"
            }
        ],
        "description": "Use the <code>browser.browserSettings</code> API to control global settings of the browser.",
        "namespace": "browserSettings",
        "permissions": [
            "browserSettings"
        ],
        "properties": {
            "allowPopupsForUserEvents": {
                "$ref": "types.Setting",
                "annotations": [
                    {
                        "mdn_documentation_url": "https://developer.mozilla.org/docs/Mozilla/Add-ons/WebExtensions/API/browserSettings/allowPopupsForUserEvents"
                    },
                    {
                        "version_added": "57"
                    }
                ],
                "description": "Allows or disallows pop-up windows from opening in response to user events."
            },
            "cacheEnabled": {
                "$ref": "types.Setting",
                "annotations": [
                    {
                        "mdn_documentation_url": "https://developer.mozilla.org/docs/Mozilla/Add-ons/WebExtensions/API/browserSettings/cacheEnabled"
                    },
                    {
                        "version_added": "56"
                    }
                ],
                "description": "Enables or disables the browser cache."
            },
            "closeTabsByDoubleClick": {
                "$ref": "types.Setting",
                "annotations": [
                    {
                        "version_added": false
                    },
                    {
                        "mdn_documentation_url": "https://developer.mozilla.org/docs/Mozilla/Add-ons/WebExtensions/API/browserSettings/closeTabsByDoubleClick"
                    }
                ],
                "description": "This boolean setting controls whether the selected tab can be closed with a double click."
            },
            "contextMenuShowEvent": {
                "$ref": "types.Setting",
                "annotations": [
                    {
                        "mdn_documentation_url": "https://developer.mozilla.org/docs/Mozilla/Add-ons/WebExtensions/API/browserSettings/contextMenuShowEvent"
                    },
                    {
                        "version_added": "59"
                    }
                ],
                "description": "Controls after which mouse event context menus popup. This setting's value is of type ContextMenuMouseEvent, which has possible values of <code>mouseup</code> and <code>mousedown</code>."
            },
            "ftpProtocolEnabled": {
                "$ref": "types.Setting",
                "annotations": [
                    {
                        "additional_properties": {
                            "readOnly": true
                        }
                    },
                    {
                        "mdn_documentation_url": "https://developer.mozilla.org/docs/Mozilla/Add-ons/WebExtensions/API/browserSettings/ftpProtocolEnabled"
                    },
                    {
                        "bcd": true,
                        "note": "From version 88, this setting is read-only (see <a href=\"https://bugzil.la/1626365\">bug 1626365</a>)."
                    },
                    {
                        "version_added": "72"
                    }
                ],
                "deprecated": "FTP support was removed from Thunderbird in bug 1574475",
                "description": "Returns whether the FTP protocol is enabled. Read-only."
            },
            "homepageOverride": {
                "$ref": "types.Setting",
                "annotations": [
                    {
                        "version_added": false
                    },
                    {
                        "additional_properties": {
                            "readOnly": true
                        }
                    },
                    {
                        "mdn_documentation_url": "https://developer.mozilla.org/docs/Mozilla/Add-ons/WebExtensions/API/browserSettings/homepageOverride"
                    }
                ],
                "description": "Returns the value of the overridden home page. Read-only."
            },
            "imageAnimationBehavior": {
                "$ref": "types.Setting",
                "annotations": [
                    {
                        "mdn_documentation_url": "https://developer.mozilla.org/docs/Mozilla/Add-ons/WebExtensions/API/browserSettings/imageAnimationBehavior"
                    },
                    {
                        "version_added": "57"
                    }
                ],
                "description": "Controls the behaviour of image animation in the browser. This setting's value is of type ImageAnimationBehavior, defaulting to <code>normal</code>."
            },
            "newTabPageOverride": {
                "$ref": "types.Setting",
                "annotations": [
                    {
                        "version_added": false
                    },
                    {
                        "additional_properties": {
                            "readOnly": true
                        }
                    },
                    {
                        "mdn_documentation_url": "https://developer.mozilla.org/docs/Mozilla/Add-ons/WebExtensions/API/browserSettings/newTabPageOverride"
                    }
                ],
                "description": "Returns the value of the overridden new tab page. Read-only."
            },
            "newTabPosition": {
                "$ref": "types.Setting",
                "annotations": [
                    {
                        "version_added": false
                    },
                    {
                        "mdn_documentation_url": "https://developer.mozilla.org/docs/Mozilla/Add-ons/WebExtensions/API/browserSettings/newTabPosition"
                    }
                ],
                "description": "Controls where new tabs are opened. <val>afterCurrent</val> will open all new tabs next to the current tab, <val>relatedAfterCurrent</val> will open only related tabs next to the current tab, and <val>atEnd</val> will open all tabs at the end of the tab strip. The default is <val>relatedAfterCurrent</val>."
            },
            "openBookmarksInNewTabs": {
                "$ref": "types.Setting",
                "annotations": [
                    {
                        "version_added": false
                    },
                    {
                        "mdn_documentation_url": "https://developer.mozilla.org/docs/Mozilla/Add-ons/WebExtensions/API/browserSettings/openBookmarksInNewTabs"
                    }
                ],
                "description": "This boolean setting controls whether bookmarks are opened in the current tab or in a new tab."
            },
            "openSearchResultsInNewTabs": {
                "$ref": "types.Setting",
                "annotations": [
                    {
                        "version_added": false
                    },
                    {
                        "mdn_documentation_url": "https://developer.mozilla.org/docs/Mozilla/Add-ons/WebExtensions/API/browserSettings/openSearchResultsInNewTabs"
                    }
                ],
                "description": "This boolean setting controls whether search results are opened in the current tab or in a new tab."
            },
            "openUrlbarResultsInNewTabs": {
                "$ref": "types.Setting",
                "annotations": [
                    {
                        "version_added": false
                    },
                    {
                        "mdn_documentation_url": "https://developer.mozilla.org/docs/Mozilla/Add-ons/WebExtensions/API/browserSettings/openUrlbarResultsInNewTabs"
                    }
                ],
                "description": "This boolean setting controls whether urlbar results are opened in the current tab or in a new tab."
            },
            "overrideContentColorScheme": {
                "$ref": "types.Setting",
                "annotations": [
                    {
                        "mdn_documentation_url": "https://developer.mozilla.org/docs/Mozilla/Add-ons/WebExtensions/API/browserSettings/overrideContentColorScheme"
                    },
                    {
                        "version_added": "95"
                    }
                ],
                "description": "This setting controls whether a light or dark color scheme overrides the page's preferred color scheme."
            },
            "overrideDocumentColors": {
                "$ref": "types.Setting",
                "annotations": [
                    {
                        "mdn_documentation_url": "https://developer.mozilla.org/docs/Mozilla/Add-ons/WebExtensions/API/browserSettings/overrideDocumentColors"
                    },
                    {
                        "version_added": "61"
                    }
                ],
                "description": "This setting controls whether the user-chosen colors override the page's colors."
            },
            "useDocumentFonts": {
                "$ref": "types.Setting",
                "annotations": [
                    {
                        "mdn_documentation_url": "https://developer.mozilla.org/docs/Mozilla/Add-ons/WebExtensions/API/browserSettings/useDocumentFonts"
                    },
                    {
                        "version_added": "61"
                    }
                ],
                "description": "This setting controls whether the document's fonts are used."
            },
            "verticalTabs": {
                "$ref": "types.Setting",
                "description": "This boolean setting controls whether vertical tabs are enabled."
            },
            "webNotificationsDisabled": {
                "$ref": "types.Setting",
                "annotations": [
                    {
                        "mdn_documentation_url": "https://developer.mozilla.org/docs/Mozilla/Add-ons/WebExtensions/API/browserSettings/webNotificationsDisabled"
                    },
                    {
                        "version_added": "58"
                    }
                ],
                "description": "Disables webAPI notifications."
            },
            "zoomFullPage": {
                "$ref": "types.Setting",
                "annotations": [
                    {
                        "mdn_documentation_url": "https://developer.mozilla.org/docs/Mozilla/Add-ons/WebExtensions/API/browserSettings/zoomFullPage"
                    },
                    {
                        "version_added": "75"
                    }
                ],
                "description": "This boolean setting controls whether zoom is applied to the full page or to text only."
            },
            "zoomSiteSpecific": {
                "$ref": "types.Setting",
                "annotations": [
                    {
                        "version_added": false
                    },
                    {
                        "mdn_documentation_url": "https://developer.mozilla.org/docs/Mozilla/Add-ons/WebExtensions/API/browserSettings/zoomSiteSpecific"
                    }
                ],
                "description": "This boolean setting controls whether zoom is applied on a per-site basis or to the current tab only. If privacy.resistFingerprinting is true, this setting has no effect and zoom is applied to the current tab only."
            }
        },
        "types": [
            {
                "description": "How images should be animated in the browser.",
                "enum": [
                    "normal",
                    "none",
                    "once"
                ],
                "id": "ImageAnimationBehavior",
                "type": "string"
            },
            {
                "description": "After which mouse event context menus should popup.",
                "enum": [
                    "mouseup",
                    "mousedown"
                ],
                "id": "ContextMenuMouseEvent",
                "type": "string"
            },
            {
                "description": "Color management mode.",
                "enum": [
                    "off",
                    "full",
                    "tagged_only"
                ],
                "id": "ColorManagementMode",
                "type": "string"
            }
        ]
    },
    {
        "annotations": [
            {
                "mdn_documentation_url": "https://developer.mozilla.org/docs/Mozilla/Add-ons/WebExtensions/API/browserSettings/colorManagement"
            },
            {
                "version_added": "91"
            }
        ],
        "description": "Use the <code>browserSettings.colorManagement</code> API to query and set items related to color management.",
        "namespace": "browserSettings.colorManagement",
        "permissions": [
            "browserSettings"
        ],
        "properties": {
            "mode": {
                "$ref": "types.Setting",
                "description": "This setting controls the mode used for color management and must be a string from $(ref:browserSettings.ColorManagementMode)"
            },
            "useNativeSRGB": {
                "$ref": "types.Setting",
                "description": "This boolean setting controls whether or not native sRGB color management is used."
            },
            "useWebRenderCompositor": {
                "$ref": "types.Setting",
                "description": "This boolean setting controls whether or not the WebRender compositor is used."
            }
        }
    }
]