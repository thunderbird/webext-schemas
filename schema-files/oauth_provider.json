[
    {
        "annotations": [
            {
                "version_added": "140"
            }
        ],
        "applicationVersion": "155.0.1",
        "namespace": "manifest",
        "types": [
            {
                "$extend": "WebExtensionManifest",
                "properties": {
                    "oauth_provider": {
                        "annotations": [
                            {
                                "version_added": "140"
                            }
                        ],
                        "description": "Describes an OAuth authentication provider for Thunderbird. You will need to have a client ID registered with the provider to use this API.",
                        "optional": true,
                        "properties": {
                            "authorizationEndpoint": {
                                "annotations": [
                                    {
                                        "version_added": "140"
                                    }
                                ],
                                "description": "OAuth authorization endpoint address.",
                                "format": "url",
                                "type": "string"
                            },
                            "clientId": {
                                "annotations": [
                                    {
                                        "version_added": "140"
                                    }
                                ],
                                "description": "Identifies the OAuth client to the server.",
                                "type": "string"
                            },
                            "clientSecret": {
                                "annotations": [
                                    {
                                        "version_added": "140"
                                    }
                                ],
                                "description": "Identifies the OAuth client to the server.",
                                "optional": true,
                                "type": "string"
                            },
                            "emailDomains": {
                                "annotations": [
                                    {
                                        "version_added": "155"
                                    }
                                ],
                                "description": "Email domains for which this OAuth provider should be used. If omitted, the provider applies to all domains in use with a given hostname",
                                "items": {
                                    "type": "string"
                                },
                                "minItems": 1,
                                "optional": true,
                                "type": "array"
                            },
                            "hostnames": {
                                "annotations": [
                                    {
                                        "version_added": "140"
                                    }
                                ],
                                "description": "One or more server hostnames that use this OAuth provider. Include any service or autodiscovery hostnames that may initiate OAuth authentication. For example, to override many Microsoft configurations, both of these would be needed - [\"office365.com\", \"outlook.com\"]",
                                "items": {
                                    "type": "string"
                                },
                                "minItems": 1,
                                "type": "array"
                            },
                            "issuer": {
                                "annotations": [
                                    {
                                        "version_added": "140"
                                    }
                                ],
                                "description": "A string to identify this provider in the login manager. This <em>should</em> match the hostname of the authorization endpoint, although that is not required.",
                                "type": "string"
                            },
                            "issuerIdentifier": {
                                "annotations": [
                                    {
                                        "version_added": "153"
                                    }
                                ],
                                "description": "The OAuth authorization server issuer identifier, as defined by RFC 9207. If provided, it <em>must</em> be an exact string match to what the provider gives in the iss field.",
                                "optional": true,
                                "type": "string"
                            },
                            "redirectionEndpoint": {
                                "annotations": [
                                    {
                                        "version_added": "140"
                                    }
                                ],
                                "description": "OAuth redirection endpoint.",
                                "type": "string"
                            },
                            "scopes": {
                                "annotations": [
                                    {
                                        "version_added": "140"
                                    }
                                ],
                                "description": "The scopes to request when using this OAuth provider.",
                                "type": "string"
                            },
                            "tokenEndpoint": {
                                "annotations": [
                                    {
                                        "version_added": "140"
                                    }
                                ],
                                "description": "OAuth token endpoint address.",
                                "format": "url",
                                "type": "string"
                            },
                            "useExternalBrowser": {
                                "annotations": [
                                    {
                                        "version_added": "153"
                                    }
                                ],
                                "description": "If the login flow should use the system web browser. If true, the redirectionEndpoint <em>must</em> be a loopback address, so an origin of http://127.0.0.1 or http://localhost.",
                                "optional": true,
                                "type": "boolean"
                            },
                            "usePKCE": {
                                "annotations": [
                                    {
                                        "version_added": "140"
                                    }
                                ],
                                "description": "If the authorization uses PKCE.",
                                "optional": true,
                                "type": "boolean"
                            }
                        },
                        "type": "object"
                    }
                }
            }
        ]
    },
    {
        "annotations": [
            {
                "text": "The oauthProvider API allows to manage OAuth authentication providers for Thunderbird to use when connecting to mail/address book/calendar services."
            },
            {
                "version_added": false
            }
        ],
        "namespace": "oauthProvider"
    }
]