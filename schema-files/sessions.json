        "applicationVersion": "155.0.1",
        "namespace": "manifest",
        "types": [
            {
                "$extend": "OptionalPermission",
                "choices": [
                    {
                        "enum": [
                            "sessions"
                        ],
                        "enums": {
                            "sessions": {
                                "annotations": [
                                    {
                                        "version_added": "140"
                                    }
                                ]
                            }
                        },
                        "type": "string"
                    }
                ]
            }
        ]
    },
    {
        "annotations": [
            {
                "text": "Thunderbird's sessions API is similar to the <a href='https://developer.mozilla.org/en-US/docs/Mozilla/Add-ons/WebExtensions/API/sessions'>Firefox sessions API</a>, but it doesn't support accessing or restoring closed tabs."
            },
            {
                "note": "The Sessions API currently does not require the <permission>sessions</permission> permission, but it will soon. It's recommended to request this permission before it becomes mandatory, to ensure your add-on continues to function properly."
            },
            {
                "version_added": "115"
            }
        ],
        "description": "The sessions API allows to add tab related session data to Thunderbird's tabs, which will be restored on app restart.",
        "functions": [
            {
                "annotations": [
                    {
                        "api_documentation_url": "https://webextension-api.thunderbird.net/en/mv3/sessions.html#settabvalue-tabid-key-value"
                    },
                    {
                        "version_added": "115"
                    }
                ],
                "async": true,
                "description": "Store a key/value pair associated with a given tab.",
                "name": "setTabValue",
                "parameters": [
                    {
                        "annotations": [
                            {
                                "version_added": "115"
                            }
                        ],
                        "description": "ID of the tab with which you want to associate the data. Error is thrown if ID is invalid.",
                        "name": "tabId",
                        "type": "integer"
                    },
                    {
                        "annotations": [
                            {
                                "version_added": "115"
                            }
                        ],
                        "description": "Key that you can later use to retrieve this particular data value.",
                        "name": "key",
                        "type": "string"
                    },
                    {
                        "annotations": [
                            {
                                "version_added": "115"
                            }
                        ],
                        "name": "value",
                        "type": "string"
                    }
                ],
                "type": "function"
            },
            {
                "annotations": [
                    {
                        "api_documentation_url": "https://webextension-api.thunderbird.net/en/mv3/sessions.html#gettabvalue-tabid-key"
                    },
                    {
                        "version_added": "115"
                    }
                ],
                "async": "callback",
                "description": "Retrieve a previously stored value for a given tab, given its key. Returns <var>undefined</var> if the requested <var>key</var> does not exist for the given <var>tabId</var>.",
                "name": "getTabValue",
                "parameters": [
                    {
                        "annotations": [
                            {
                                "version_added": "115"
                            }
                        ],
                        "description": "ID of the tab whose data you are trying to retrieve. Error is thrown if ID is invalid.",
                        "name": "tabId",
                        "type": "integer"
                    },
                    {
                        "annotations": [
                            {
                                "version_added": "115"
                            }
                        ],
                        "description": "Key identifying the particular value to retrieve.",
                        "name": "key",
                        "type": "string"
                    },
                    {
                        "annotations": [
                            {
                                "version_added": "115"
                            }
                        ],
                        "name": "callback",
                        "optional": true,
                        "parameters": [
                            {
                                "annotations": [
                                    {
                                        "version_added": "115"
                                    }
                                ],
                                "optional": true,
                                "type": "string"
                            }
                        ],
                        "type": "function"
                    }
                ],
                "type": "function"
            },
            {
                "annotations": [
                    {
                        "api_documentation_url": "https://webextension-api.thunderbird.net/en/mv3/sessions.html#removetabvalue-tabid-key"
                    },
                    {
                        "version_added": "115"
                    }
                ],
                "async": true,
                "description": "Remove a key/value pair from a given tab.",
                "name": "removeTabValue",
                "parameters": [
                    {
                        "annotations": [
                            {
                                "version_added": "115"
                            }
                        ],
                        "description": "ID of the tab whose data you are trying to remove. Error is thrown if ID is invalid.",
                        "name": "tabId",
                        "type": "integer"
                    },
                    {
                        "annotations": [
                            {
                                "version_added": "115"
                            }
                        ],
                        "description": "Key identifying the particular value to remove.",
                        "name": "key",
                        "type": "string"
                    }
                ],
                "type": "function"
            }
        ],
        "namespace": "sessions"
    }
]