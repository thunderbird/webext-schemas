    {
        "annotations": [
            {
                "version_added": "82"
            }
        ],
        "description": "The composeScripts API allows to register and unregister scripts for the message compose window.",
        "functions": [
            {
                "annotations": [
                    {
                        "note": "Registered scripts will only be applied to newly opened message composer tabs. To apply the script to already open message composer tab, manually inject your script by calling $(ref:tabs.executeScript) for each of the open <var>messageCompose</var> tabs."
                    },
                    {
                        "api_documentation_url": "https://webextension-api.thunderbird.net/en/beta-mv2/composeScripts.html#register-composescriptoptions"
                    },
                    {
                        "version_added": "82"
                    }
                ],
                "async": true,
                "description": "Register a compose script programmatically.",
                "name": "register",
                "parameters": [
                    {
                        "$ref": "RegisteredComposeScriptOptions",
                        "annotations": [
                            {
                                "version_added": "82"
                            }
                        ],
                        "name": "composeScriptOptions"
                    }
                ],
                "type": "function"
            }
        ],
        "namespace": "composeScripts",
        "permissions": [
            "compose"
        ],
        "types": [
            {
                "annotations": [
                    {
                        "api_documentation_url": "https://webextension-api.thunderbird.net/en/beta-mv2/composeScripts.html#registeredcomposescriptoptions"
                    },
                    {
                        "version_added": "82"
                    }
                ],
                "description": "Details of a compose script registered programmatically.",
                "id": "RegisteredComposeScriptOptions",
                "properties": {
                    "css": {
                        "annotations": [
                            {
                                "version_added": "82"
                            }
                        ],
                        "description": "The list of CSS files to inject.",
                        "items": {
                            "$ref": "extensionTypes.ExtensionFileOrCode"
                        },
                        "optional": true,
                        "type": "array"
                    },
                    "js": {
                        "annotations": [
                            {
                                "version_added": "82"
                            }
                        ],
                        "description": "The list of JavaScript files to inject.",
                        "items": {
                            "$ref": "extensionTypes.ExtensionFileOrCode"
                        },
                        "optional": true,
                        "type": "array"
                    }
                },
                "type": "object"
            },
            {
                "annotations": [
                    {
                        "api_documentation_url": "https://webextension-api.thunderbird.net/en/beta-mv2/composeScripts.html#registeredcomposescript"
                    },
                    {
                        "version_added": "82"
                    }
                ],
                "description": "An object that represents a compose script registered programmatically.",
                "functions": [
                    {
                        "annotations": [
                            {
                                "version_added": "82"
                            }
                        ],
                        "async": true,
                        "description": "Unregister a compose script registered programmatically.",
                        "name": "unregister",
                        "parameters": [],
                        "type": "function"
                    }
                ],
                "id": "RegisteredComposeScript",
                "type": "object"
            }
        ]
    },
    {
        "annotations": [
            {
                "version_added": "82"
            }
        ],
        "description": "The messageDisplayScripts API allows to register and unregister scripts for the message display window.",
        "functions": [
            {
                "annotations": [
                    {
                        "note": "Registered scripts will only be applied to newly opened messages. To apply the script to already open messages, manually inject your script by calling $(ref:tabs.executeScript) for each of the open <var>messageDisplay</var> tabs."
                    },
                    {
                        "api_documentation_url": "https://webextension-api.thunderbird.net/en/beta-mv2/messageDisplayScripts.html#register-messagedisplayscriptoptions"
                    },
                    {
                        "version_added": "82"
                    }
                ],
                "async": true,
                "description": "Register a message display script programmatically.",
                "name": "register",
                "parameters": [
                    {
                        "$ref": "RegisteredMessageDisplayScriptOptions",
                        "annotations": [
                            {
                                "version_added": "82"
                            }
                        ],
                        "name": "messageDisplayScriptOptions"
                    }
                ],
                "type": "function"
            }
        ],
        "namespace": "messageDisplayScripts",
        "permissions": [
            "messagesModify"
        ],
        "types": [
            {
                "annotations": [
                    {
                        "api_documentation_url": "https://webextension-api.thunderbird.net/en/beta-mv2/messageDisplayScripts.html#registeredmessagedisplayscriptoptions"
                    },
                    {
                        "version_added": "82"
                    }
                ],
                "description": "Details of a message display script registered programmatically",
                "id": "RegisteredMessageDisplayScriptOptions",
                "properties": {
                    "css": {
                        "annotations": [
                            {
                                "version_added": "82"
                            }
                        ],
                        "description": "The list of CSS files to inject",
                        "items": {
                            "$ref": "extensionTypes.ExtensionFileOrCode"
                        },
                        "optional": true,
                        "type": "array"
                    },
                    "js": {
                        "annotations": [
                            {
                                "version_added": "82"
                            }
                        ],
                        "description": "The list of JavaScript files to inject",
                        "items": {
                            "$ref": "extensionTypes.ExtensionFileOrCode"
                        },
                        "optional": true,
                        "type": "array"
                    },
                    "runAt": {
                        "annotations": [
                            {
                                "version_added": "126"
                            }
                        ],
                        "default": "document_idle",
                        "description": "Determines when the files specified in css and js are injected. The states directly correspond to <code>Document.readyState</code>: <var>loading</var>, <var>interactive</var> and <var>complete</var>",
                        "enum": [
                            "document_start",
                            "document_end",
                            "document_idle"
                        ],
                        "enums": {
                            "document_end": {
                                "annotations": [
                                    {
                                        "text": "Inject the script after the DOM is complete, but before subresources like images and frames have loaded."
                                    },
                                    {
                                        "version_added": "126"
                                    }
                                ]
                            },
                            "document_idle": {
                                "annotations": [
                                    {
                                        "text": "Inject the script after the page is fully loaded. This is the default."
                                    },
                                    {
                                        "version_added": "126"
                                    }
                                ]
                            },
                            "document_start": {
                                "annotations": [
                                    {
                                        "text": "Inject the script after the document is created, but before any other content is loaded."
                                    },
                                    {
                                        "version_added": "126"
                                    }
                                ]
                            }
                        },
                        "optional": true,
                        "type": "string"
                    }
                },
                "type": "object"
            },
            {
                "annotations": [
                    {
                        "api_documentation_url": "https://webextension-api.thunderbird.net/en/beta-mv2/messageDisplayScripts.html#registeredmessagedisplayscript"
                    },
                    {
                        "version_added": "82"
                    }
                ],
                "description": "An object that represents a message display script registered programmatically",
                "functions": [
                    {
                        "annotations": [
                            {
                                "version_added": "82"
                            }
                        ],
                        "async": true,
                        "description": "Unregister a message display script registered programmatically",
                        "name": "unregister",
                        "parameters": [],
                        "type": "function"
                    }
                ],
                "id": "RegisteredMessageDisplayScript",
                "type": "object"
            }
        ]
    }
]