[
    {
        "annotations": [
            {
                "version_added": "115"
            }
        ],
        "description": "The spaces API allows to manage built-in and custom spaces, and to add buttons for custom spaces to Thunderbird's spaces toolbar.",
        "functions": [
            {
                "annotations": [
                    {
                        "api_documentation_url": "https://webextension-api.thunderbird.net/en/mv2/spaces.html#create-name-tabproperties-buttonproperties"
                    },
                    {
                        "version_added": "115"
                    }
                ],
                "async": "callback",
                "description": "Creates a new space and adds its button to the spaces toolbar.",
                "name": "create",
                "parameters": [
                    {
                        "annotations": [
                            {
                                "version_added": "115"
                            }
                        ],
                        "description": "The name to assign to this space. May only contain alphanumeric characters and underscores. Must be unique for this extension.",
                        "name": "name",
                        "pattern": "^[a-zA-Z0-9_]+$",
                        "type": "string"
                    },
                    {
                        "annotations": [
                            {
                                "version_added": "115"
                            }
                        ],
                        "choices": [
                            {
                                "annotations": [
                                    {
                                        "version_added": "115"
                                    }
                                ],
                                "type": "string"
                            },
                            {
                                "$ref": "spaces.SpaceTabProperties",
                                "annotations": [
                                    {
                                        "version_added": "135"
                                    }
                                ]
                            }
                        ],
                        "description": "The properties for the new tab being opened, when the associated button in the spaces toolbar is clicked. Either a <em>string</em> specifying the default URL, or a $(ref:spaces.SpaceTabProperties) object. The URL may point to a WebExtension page or a web page.",
                        "name": "tabProperties"
                    },
                    {
                        "$ref": "spaces.SpaceButtonProperties",
                        "annotations": [
                            {
                                "version_added": "115"
                            }
                        ],
                        "default": {},
                        "description": "Properties of the button in the spaces toolbar for the new space.",
                        "name": "buttonProperties",
                        "optional": true
                    },
                    {
                        "annotations": [
                            {
                                "version_added": "115"
                            }
                        ],
                        "name": "callback",
                        "optional": true,
                        "parameters": [
                            {
                                "$ref": "spaces.Space",
                                "annotations": [
                                    {
                                        "version_added": "115"
                                    }
                                ],
                                "name": "space"
                            }
                        ],
                        "type": "function"
                    }
                ],
                "type": "function"
            },
            {
                "annotations": [
                    {
                        "api_documentation_url": "https://webextension-api.thunderbird.net/en/mv2/spaces.html#get-spaceid"
                    },
                    {
                        "version_added": "115"
                    }
                ],
                "async": "callback",
                "description": "Retrieves details about the specified space.",
                "name": "get",
                "parameters": [
                    {
                        "annotations": [
                            {
                                "version_added": "115"
                            }
                        ],
                        "description": "The id of the space.",
                        "minimum": 1,
                        "name": "spaceId",
                        "type": "integer"
                    },
                    {
                        "annotations": [
                            {
                                "version_added": "115"
                            }
                        ],
                        "name": "callback",
                        "optional": true,
                        "parameters": [
                            {
                                "$ref": "spaces.Space",
                                "annotations": [
                                    {
                                        "version_added": "115"
                                    }
                                ],
                                "name": "space"
                            }
                        ],
                        "type": "function"
                    }
                ],
                "type": "function"
            },
            {
                "annotations": [
                    {
                        "api_documentation_url": "https://webextension-api.thunderbird.net/en/mv2/spaces.html#query-queryinfo"
                    },
                    {
                        "version_added": "115"
                    }
                ],
                "async": "callback",
                "description": "Gets all spaces that have the specified properties, or all spaces if no properties are specified.",
                "name": "query",
                "parameters": [
                    {
                        "annotations": [
                            {
                                "version_added": "115"
                            }
                        ],
                        "default": {},
                        "name": "queryInfo",
                        "optional": true,
                        "properties": {
                            "extensionId": {
                                "annotations": [
                                    {
                                        "version_added": "115"
                                    }
                                ],
                                "description": "Id of the extension which should own the spaces. The <permission>management</permission> permission is required to be able to match against extension ids.",
                                "optional": true,
                                "type": "string"
                            },
                            "id": {
                                "annotations": [
                                    {
                                        "version_added": "115"
                                    }
                                ],
                                "description": "The id of the space.",
                                "minimum": 1,
                                "optional": true,
                                "type": "integer"
                            },
                            "isBuiltIn": {
                                "annotations": [
                                    {
                                        "version_added": "115"
                                    }
                                ],
                                "description": "Spaces should be default Thunderbird spaces.",
                                "optional": true,
                                "type": "boolean"
                            },
                            "isSelfOwned": {
                                "annotations": [
                                    {
                                        "version_added": "115"
                                    }
                                ],
                                "description": "Spaces should have been created by this extension.",
                                "optional": true,
                                "type": "boolean"
                            },
                            "name": {
                                "annotations": [
                                    {
                                        "version_added": "115"
                                    }
                                ],
                                "description": "The name of the spaces (names are not unique).",
                                "optional": true,
                                "pattern": "^[a-zA-Z0-9_]+$",
                                "type": "string"
                            }
                        },
                        "type": "object"
                    },
                    {
                        "annotations": [
                            {
                                "version_added": "115"
                            }
                        ],
                        "name": "callback",
                        "optional": true,
                        "parameters": [
                            {
                                "annotations": [
                                    {
                                        "version_added": "115"
                                    }
                                ],
                                "items": {
                                    "$ref": "spaces.Space"
                                },
                                "name": "result",
                                "type": "array"
                            }
                        ],
                        "type": "function"
                    }
                ],
                "type": "function"
            },
            {
                "annotations": [
                    {
                        "api_documentation_url": "https://webextension-api.thunderbird.net/en/mv2/spaces.html#remove-spaceid"
                    },
                    {
                        "version_added": "115"
                    }
                ],
                "async": true,
                "description": "Removes the specified space, closes all its tabs and removes its button from the spaces toolbar. Throws an exception if the requested space does not exist or was not created by this extension.",
                "name": "remove",
                "parameters": [
                    {
                        "annotations": [
                            {
                                "version_added": "115"
                            }
                        ],
                        "description": "The id of the space.",
                        "minimum": 1,
                        "name": "spaceId",
                        "type": "integer"
                    }
                ],
                "type": "function"
            },
            {
                "annotations": [
                    {
                        "api_documentation_url": "https://webextension-api.thunderbird.net/en/mv2/spaces.html#update-spaceid-tabproperties-buttonproperties"
                    },
                    {
                        "version_added": "115"
                    }
                ],
                "async": true,
                "description": "Updates the specified space. Throws an exception if the requested space does not exist or was not created by this extension.",
                "name": "update",
                "parameters": [
                    {
                        "annotations": [
                            {
                                "version_added": "115"
                            }
                        ],
                        "description": "The id of the space.",
                        "minimum": 1,
                        "name": "spaceId",
                        "type": "integer"
                    },
                    {
                        "annotations": [
                            {
                                "version_added": "115"
                            }
                        ],
                        "choices": [
                            {
                                "annotations": [
                                    {
                                        "version_added": "115"
                                    }
                                ],
                                "type": "string"
                            },
                            {
                                "$ref": "spaces.SpaceTabProperties",
                                "annotations": [
                                    {
                                        "version_added": "135"
                                    }
                                ]
                            },
                            {
                                "$ref": "spaces.SpaceButtonProperties",
                                "annotations": [
                                    {
                                        "version_added": "135"
                                    }
                                ]
                            }
                        ],
                        "description": "The properties for the new tab being opened, when the associated button in the spaces toolbar is clicked. Either a <em>string</em> specifying the default URL, or a $(ref:spaces.SpaceTabProperties) object. The URL may point to a WebExtension page or a web page.",
                        "name": "tabProperties"
                    },
                    {
                        "$ref": "spaces.SpaceButtonProperties",
                        "annotations": [
                            {
                                "version_added": "115"
                            }
                        ],
                        "description": "Properties of the button in the spaces toolbar for the specified space Only specified button properties will be updated.",
                        "name": "buttonProperties",
                        "optional": true
                    }
                ],
                "type": "function"
            },
            {
                "annotations": [
                    {
                        "api_documentation_url": "https://webextension-api.thunderbird.net/en/mv2/spaces.html#open-spaceid-windowid"
                    },
                    {
                        "version_added": "115"
                    }
                ],
                "async": "callback",
                "description": "Opens or switches to the specified space. Throws an exception if the requested space does not exist or was not created by this extension.",
                "name": "open",
                "parameters": [
                    {
                        "annotations": [
                            {
                                "version_added": "115"
                            }
                        ],
                        "description": "The id of the space.",
                        "minimum": 1,
                        "name": "spaceId",
                        "type": "integer"
                    },
                    {
                        "annotations": [
                            {
                                "version_added": "115"
                            }
                        ],
                        "description": "The id of the normal window, where the space should be opened. Defaults to the most recent normal window.",
                        "minimum": -2,
                        "name": "windowId",
                        "optional": true,
                        "type": "integer"
                    },
                    {
                        "annotations": [
                            {
                                "version_added": "115"
                            }
                        ],
                        "name": "callback",
                        "optional": true,
                        "parameters": [
                            {
                                "$ref": "tabs.Tab",
                                "annotations": [
                                    {
                                        "version_added": "115"
                                    }
                                ],
                                "description": "Details about the opened or activated space tab.",
                                "name": "tab"
                            }
                        ],
                        "type": "function"
                    }
                ],
                "type": "function"
            }
        ],
        "namespace": "spaces",
        "types": [
            {
                "annotations": [
                    {
                        "api_documentation_url": "https://webextension-api.thunderbird.net/en/mv2/spaces.html#spacetabproperties"
                    },
                    {
                        "version_added": "135"
                    }
                ],
                "description": "Properties for the new tab being opened by clicking on the associated button in the spaces toolbar.",
                "id": "SpaceTabProperties",
                "properties": {
                    "cookieStoreId": {
                        "annotations": [
                            {
                                "note": "The naming pattern of the built-in cookie stores was deliberately not changed for Thunderbird, but kept for compatibility reasons."
                            },
                            {
                                "note": "The <permission>cookies</permission> permission is required to be able to specify this property. Furthermore, the <permission>contextualIdentities</permission> permission should be requested, to enable the contextual identities feature (enabled by default only on Thunderbird Daily)."
                            },
                            {
                                "version_added": "135"
                            }
                        ],
                        "description": "The <a href='https://developer.mozilla.org/en-US/docs/Mozilla/Add-ons/WebExtensions/API/contextualIdentities/ContextualIdentity#cookiestoreid'>CookieStore</a> id used by the tab. Either a custom id created using the <a href='https://developer.mozilla.org/en-US/docs/Mozilla/Add-ons/WebExtensions/API/contextualIdentities'>contextualIdentities API</a>, or a built-in one: <var>firefox-default</var>, <var>firefox-container-1</var>, <var>firefox-container-2</var>, <var>firefox-container-3</var>, <var>firefox-container-4</var>, <var>firefox-container-5</var>.",
                        "optional": true,
                        "type": "string"
                    },
                    "linkHandler": {
                        "annotations": [
                            {
                                "version_added": "136"
                            }
                        ],
                        "description": "Thunderbird is a mail client, not a browser. It is possible to load a web page, but opening follow-up pages through hyperlinks should be handled by the user's default browser. This property specifies to what extent this behavior should be enforced. The default <var>balanced</var> link handler will open links to the same host directly in Thunderbird, everything else will be opened in the user's default browser. A <var>relaxed</var> link handler will open all links inside of Thunderbird, a <var>strict</var> link handler will open all links in the user's default browser, except links to the same page.",
                        "enum": [
                            "strict",
                            "balanced",
                            "relaxed"
                        ],
                        "enums": {
                            "balanced": {
                                "annotations": [
                                    {
                                        "version_added": "136"
                                    }
                                ]
                            },
                            "relaxed": {
                                "annotations": [
                                    {
                                        "version_added": "136"
                                    }
                                ]
                            },
                            "strict": {
                                "annotations": [
                                    {
                                        "version_added": "136"
                                    }
                                ]
                            }
                        },
                        "optional": true,
                        "type": "string"
                    },
                    "url": {
                        "annotations": [
                            {
                                "version_added": "135"
                            }
                        ],
                        "description": "The default URL. May point to a WebExtension page or a web page.",
                        "optional": true,
                        "type": "string"
                    }
                },
                "type": "object"
            },
            {
                "annotations": [
                    {
                        "api_documentation_url": "https://webextension-api.thunderbird.net/en/mv2/spaces.html#spacebuttonproperties"
                    },
                    {
                        "version_added": "115"
                    }
                ],
                "description": "Properties of a button in the spaces toolbar.",
                "id": "SpaceButtonProperties",
                "properties": {
                    "badgeBackgroundColor": {
                        "annotations": [
                            {
                                "version_added": "115"
                            }
                        ],
                        "choices": [
                            {
                                "annotations": [
                                    {
                                        "version_added": "115"
                                    }
                                ],
                                "type": "string"
                            },
                            {
                                "$ref": "spaces.ColorArray",
                                "annotations": [
                                    {
                                        "version_added": "115"
                                    }
                                ]
                            }
                        ],
                        "description": "Sets the background color of the badge. Can be specified as an array of four integers in the range [0,255] that make up the RGBA color of the badge. For example, opaque red is <var>[255, 0, 0, 255]</var>. Can also be a string with an HTML color name (<var>red</var>) or a HEX color value (<var>#FF0000</var> or <var>#F00</var>). Reset when set to an empty string.",
                        "optional": true
                    },
                    "badgeText": {
                        "annotations": [
                            {
                                "version_added": "115"
                            }
                        ],
                        "description": "Sets the badge text for the button in the spaces toolbar. The badge is displayed on top of the icon. Any number of characters can be set, but only about four can fit in the space. Removed when set to an empty string.",
                        "optional": true,
                        "type": "string"
                    },
                    "defaultIcons": {
                        "annotations": [
                            {
                                "version_added": "115"
                            }
                        ],
                        "choices": [
                            {
                                "annotations": [
                                    {
                                        "version_added": "115"
                                    }
                                ],
                                "type": "string"
                            },
                            {
                                "$ref": "manifest.IconPath",
                                "annotations": [
                                    {
                                        "version_added": "115"
                                    }
                                ]
                            }
                        ],
                        "description": "The paths to one or more icons for the button in the spaces toolbar. Reset to the extension icon, when set to an empty string.",
                        "optional": true
                    },
                    "themeIcons": {
                        "annotations": [
                            {
                                "version_added": "115"
                            }
                        ],
                        "description": "Specifies dark and light icons for the button in the spaces toolbar to be used with themes: The <var>light</var> icons will be used on dark backgrounds and vice versa. At least the set for <em>16px</em> icons should be specified. The set for <em>32px</em> icons will be used on screens with a very high pixel density, if specified. Reset when set to an empty array.",
                        "items": {
                            "$ref": "manifest.ThemeIcons"
                        },
                        "optional": true,
                        "type": "array"
                    },
                    "title": {
                        "annotations": [
                            {
                                "version_added": "115"
                            }
                        ],
                        "description": "The title for the button in the spaces toolbar, used in the tooltip of the button and as the displayed name in the overflow menu. Reset to the name of the extension, when set to an empty string.",
                        "optional": true,
                        "type": "string"
                    }
                },
                "type": "object"
            },
            {
                "annotations": [
                    {
                        "api_documentation_url": "https://webextension-api.thunderbird.net/en/mv2/spaces.html#colorarray"
                    },
                    {
                        "version_added": "115"
                    }
                ],
                "description": "An array of four integers in the range [0,255] that make up the RGBA color. For example, opaque red is <var>[255, 0, 0, 255]</var>.",
                "id": "ColorArray",
                "items": {
                    "maximum": 255,
                    "minimum": 0,
                    "type": "integer"
                },
                "maxItems": 4,
                "minItems": 4,
                "type": "array"
            },
            {
                "annotations": [
                    {
                        "api_documentation_url": "https://webextension-api.thunderbird.net/en/mv2/spaces.html#space"
                    },
                    {
                        "version_added": "115"
                    }
                ],
                "id": "Space",
                "properties": {
                    "extensionId": {
                        "annotations": [
                            {
                                "version_added": "115"
                            }
                        ],
                        "description": "The id of the extension which owns the space. The <permission>management</permission> permission is required to include this property.",
                        "optional": true,
                        "type": "string"
                    },
                    "id": {
                        "annotations": [
                            {
                                "version_added": "115"
                            }
                        ],
                        "description": "The id of the space.",
                        "minimum": 1,
                        "type": "integer"
                    },
                    "isBuiltIn": {
                        "annotations": [
                            {
                                "version_added": "115"
                            }
                        ],
                        "description": "Whether this space is one of the default Thunderbird spaces, or an extension space.",
                        "type": "boolean"
                    },
                    "isSelfOwned": {
                        "annotations": [
                            {
                                "version_added": "115"
                            }
                        ],
                        "description": "Whether this space was created by this extension.",
                        "type": "boolean"
                    },
                    "name": {
                        "annotations": [
                            {
                                "version_added": "115"
                            }
                        ],
                        "description": "The name of the space. Names are unique for a single extension, but different extensions may use the same name.",
                        "pattern": "^[a-zA-Z0-9_]+$",
                        "type": "string"
                    }
                },
                "type": "object"
            }
        ]
    },
    {
        "applicationVersion": "155.0.1",
        "namespace": "manifest"
    }
]