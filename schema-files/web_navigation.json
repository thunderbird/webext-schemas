        "functions": [
            {
                "annotations": [
                    {
                        "mdn_documentation_url": "https://developer.mozilla.org/docs/Mozilla/Add-ons/WebExtensions/API/webNavigation/getFrame"
                    },
                    {
                        "version_added": "47"
                    }
                ],
                "async": "callback",
                "description": "Retrieves information about the given frame. A frame refers to an &lt;iframe&gt; or a &lt;frame&gt; of a web page and is identified by a tab ID and a frame ID, or by its document ID.",
                "name": "getFrame",
                "parameters": [
                    {
                        "description": "Information about the frame to retrieve information about.",
                        "name": "details",
                        "properties": {
                            "documentId": {
                                "description": "The UUID of the document. If provided, tabId and frameId are optional. If all are provided, the frame is only returned if all properties match.",
                                "optional": true,
                                "type": "string"
                            },
                            "frameId": {
                                "description": "The ID of the frame in the given tab. Must be specified if documentId is not set.",
                                "minimum": 0,
                                "optional": true,
                                "type": "integer"
                            },
                            "processId": {
                                "description": "The ID of the process runs the renderer for this tab.",
                                "optional": true,
                                "type": "integer"
                            },
                            "tabId": {
                                "description": "The ID of the tab in which the frame is. Must be specified if documentId is not set.",
                                "minimum": 0,
                                "optional": true,
                                "type": "integer"
                            }
                        },
                        "type": "object"
                    },
                    {
                        "name": "callback",
                        "parameters": [
                            {
                                "description": "Information about the requested frame, null if the specified frame ID and/or tab ID are invalid.",
                                "name": "details",
                                "optional": true,
                                "properties": {
                                    "documentId": {
                                        "description": "A UUID of the document loaded.",
                                        "type": "string"
                                    },
                                    "errorOccurred": {
                                        "description": "True if the last navigation in this frame was interrupted by an error, i.e. the onErrorOccurred event fired.",
                                        "optional": true,
                                        "type": "boolean"
                                    },
                                    "frameId": {
                                        "description": "The ID of the frame. 0 indicates that this is the main frame; a positive value indicates the ID of a subframe.",
                                        "type": "integer"
                                    },
                                    "parentDocumentId": {
                                        "description": "A UUID of the parent document owning this frame. This is not set if there is no parent.",
                                        "optional": true,
                                        "type": "string"
                                    },
                                    "parentFrameId": {
                                        "description": "ID of frame that wraps the frame. Set to -1 of no parent frame exists.",
                                        "type": "integer"
                                    },
                                    "tabId": {
                                        "description": "The ID of the tab in which the frame is.",
                                        "type": "integer"
                                    },
                                    "url": {
                                        "description": "The URL currently associated with this frame, if the frame identified by the frameId existed at one point in the given tab. The fact that an URL is associated with a given frameId does not imply that the corresponding frame still exists.",
                                        "type": "string"
                                    }
                                },
                                "type": "object"
                            }
                        ],
                        "type": "function"
                    }
                ],
                "type": "function"
            },
