[
    {
        "annotations": [
            {
                "version_added": "66"
            }
        ],
        "applicationVersion": "155.0.1",
        "namespace": "manifest",
        "types": [
            {
                "annotations": [
                    {
                        "api_documentation_url": "https://webextension-api.thunderbird.net/en/mv2/commands.html#keyname"
                    },
                    {
                        "version_added": "66"
                    }
                ],
                "description": "Definition of a shortcut, for example <var>Alt+F5</var>. The string must match the shortcut format as defined by the <a href='https://developer.mozilla.org/en-US/docs/Mozilla/Add-ons/WebExtensions/manifest.json/commands#shortcut_values'>MDN page of the commands API</a>.",
                "format": "manifestShortcutKey",
                "id": "KeyName",
                "type": "string"
            },
            {
                "$extend": "WebExtensionManifest",
                "properties": {
                    "commands": {
                        "additionalProperties": {
                            "$ref": "CommandsShortcut"
                        },
                        "annotations": [
                            {
                                "text": "The <em>name</em> may also be one of the following built-in special shortcuts:"
                            },
                            {
                                "list": [
                                    "<var>_execute_browser_action</var>",
                                    "<var>_execute_compose_action</var>",
                                    "<var>_execute_message_display_action</var>"
                                ]
                            },
                            {
                                "text": "Example:"
                            },
                            {
                                "code": [
                                    "{",
                                    "  \"commands\": {",
                                    "    \"toggle-feature\": {",
                                    "      \"suggested_key\": {",
                                    "        \"default\": \"Ctrl+Shift+Y\",",
                                    "        \"linux\": \"Ctrl+Shift+U\"",
                                    "      },",
                                    "      \"description\": \"Send a 'toggle-feature' event\"",
                                    "    },",
                                    "    \"_execute_compose_action\": {",
                                    "      \"suggested_key\": {",
                                    "        \"default\": \"Alt+F5\"",
                                    "      },",
                                    "      \"description\": \"Open the compose action popup\"",
                                    "    }",
                                    "  }",
                                    "}",
                                    ""
                                ],
                                "type": "JSON"
                            },
                            {
                                "version_added": "66"
                            }
                        ],
                        "description": "A <em>dictionary object</em> defining one or more commands as <em>name-value</em> pairs, the <em>name</em> being the name of the command and the <em>value</em> being a $(ref:CommandsShortcut).",
                        "optional": true,
                        "type": "object"
                    }
                }
            },
            {
                "additionalProperties": {
                    "$ref": "UnrecognizedProperty"
                },
                "annotations": [
                    {
                        "api_documentation_url": "https://webextension-api.thunderbird.net/en/mv2/commands.html#commandsshortcut"
                    },
                    {
                        "version_added": "140"
                    }
                ],
                "id": "CommandsShortcut",
                "properties": {
                    "description": {
                        "annotations": [
                            {
                                "version_added": "140"
                            }
                        ],
                        "optional": true,
                        "preprocess": "localize",
                        "type": "string"
                    },
                    "suggested_key": {
                        "additionalProperties": {
                            "deprecated": "Unknown platform name",
                            "type": "string"
                        },
                        "annotations": [
                            {
                                "version_added": "140"
                            }
                        ],
                        "optional": true,
                        "properties": {
                            "default": {
                                "$ref": "KeyName",
                                "annotations": [
                                    {
                                        "version_added": "140"
                                    }
                                ],
                                "description": "Default key combination.",
                                "optional": true
                            },
                            "linux": {
                                "$ref": "KeyName",
                                "annotations": [
                                    {
                                        "version_added": "140"
                                    }
                                ],
                                "description": "Key combination on Linux.",
                                "optional": true
                            },
                            "mac": {
                                "$ref": "KeyName",
                                "annotations": [
                                    {
                                        "version_added": "140"
                                    }
                                ],
                                "description": "Key combination on Mac.",
                                "optional": true
                            },
                            "windows": {
                                "$ref": "KeyName",
                                "annotations": [
                                    {
                                        "version_added": "140"
                                    }
                                ],
                                "description": "Key combination on Windows.",
                                "optional": true
                            }
                        },
                        "type": "object"
                    }
                },
                "type": "object"
            }
        ]
    },
    {
        "annotations": [
            {
                "text": "Thunderbird's commands API is largely the same as the <a href='https://developer.mozilla.org/en-US/docs/Mozilla/Add-ons/WebExtensions/API/commands'>Firefox commands API</a>."
            },
            {
                "version_added": "66"
            }
        ],
        "description": "Use the commands API to add keyboard shortcuts that trigger actions in your extension, for example opening one of the action popups or sending a command to the extension.",
        "events": [
            {
                "annotations": [
                    {
                        "api_documentation_url": "https://webextension-api.thunderbird.net/en/mv2/commands.html#oncommand-command-tab"
                    },
                    {
                        "version_added": "66"
                    }
                ],
                "description": "Fired when a registered command is activated using a keyboard shortcut. This is a user input event handler. For asynchronous listeners some <a href='https://developer.mozilla.org/en-US/docs/Mozilla/Add-ons/WebExtensions/User_actions'>restrictions</a> apply.",
                "name": "onCommand",
                "parameters": [
                    {
                        "annotations": [
                            {
                                "version_added": "66"
                            }
                        ],
                        "name": "command",
                        "type": "string"
                    },
                    {
                        "$ref": "tabs.Tab",
                        "annotations": [
                            {
                                "version_added": "106"
                            }
                        ],
                        "description": "The details of the active tab while the command occurred.",
                        "name": "tab"
                    }
                ],
                "type": "function"
            },
            {
                "annotations": [
                    {
                        "api_documentation_url": "https://webextension-api.thunderbird.net/en/mv2/commands.html#onchanged-changeinfo"
                    },
                    {
                        "version_added": "115"
                    }
                ],
                "description": "Fired when a registered command's shortcut is changed.",
                "name": "onChanged",
                "parameters": [
                    {
                        "annotations": [
                            {
                                "version_added": "115"
                            }
                        ],
                        "name": "changeInfo",
                        "properties": {
                            "name": {
                                "annotations": [
                                    {
                                        "version_added": "115"
                                    }
                                ],
                                "description": "The name of the shortcut.",
                                "type": "string"
                            },
                            "newShortcut": {
                                "annotations": [
                                    {
                                        "version_added": "115"
                                    }
                                ],
                                "description": "The new shortcut active for this command, or blank if not active.",
                                "type": "string"
                            },
                            "oldShortcut": {
                                "annotations": [
                                    {
                                        "version_added": "115"
                                    }
                                ],
                                "description": "The old shortcut which is no longer active for this command, or blank if the shortcut was previously inactive.",
                                "type": "string"
                            }
                        },
                        "type": "object"
                    }
                ],
                "type": "function"
            }
        ],
        "functions": [
            {
                "annotations": [
                    {
                        "api_documentation_url": "https://webextension-api.thunderbird.net/en/mv2/commands.html#getall"
                    },
                    {
                        "version_added": "66"
                    }
                ],
                "async": "callback",
                "description": "Returns all the registered extension commands for this extension and their shortcut (if active).",
                "name": "getAll",
                "parameters": [
                    {
                        "annotations": [
                            {
                                "version_added": "66"
                            }
                        ],
                        "description": "Called to return the registered commands.",
                        "name": "callback",
                        "optional": true,
                        "parameters": [
                            {
                                "annotations": [
                                    {
                                        "version_added": "66"
                                    }
                                ],
                                "items": {
                                    "$ref": "Command"
                                },
                                "name": "commands",
                                "type": "array"
                            }
                        ],
                        "type": "function"
                    }
                ],
                "type": "function"
            },
            {
                "annotations": [
                    {
                        "api_documentation_url": "https://webextension-api.thunderbird.net/en/mv2/commands.html#openshortcutsettings"
                    },
                    {
                        "version_added": "137"
                    }
                ],
                "async": true,
                "description": "Open extension shortcuts configuration page.",
                "name": "openShortcutSettings",
                "parameters": [],
                "type": "function"
            },
            {
                "annotations": [
                    {
                        "api_documentation_url": "https://webextension-api.thunderbird.net/en/mv2/commands.html#reset-name"
                    },
                    {
                        "version_added": "66"
                    }
                ],
                "async": true,
                "description": "Reset a command's details to what is specified in the manifest.",
                "name": "reset",
                "parameters": [
                    {
                        "annotations": [
                            {
                                "version_added": "66"
                            }
                        ],
                        "description": "The name of the command.",
                        "name": "name",
                        "type": "string"
                    }
                ],
                "type": "function"
            },
            {
                "annotations": [
                    {
                        "api_documentation_url": "https://webextension-api.thunderbird.net/en/mv2/commands.html#update-detail"
                    },
                    {
                        "version_added": "66"
                    }
                ],
                "async": true,
                "description": "Update the details of an already defined command.",
                "name": "update",
                "parameters": [
                    {
                        "annotations": [
                            {
                                "version_added": "66"
                            }
                        ],
                        "description": "The new details for the command.",
                        "name": "detail",
                        "properties": {
                            "description": {
                                "annotations": [
                                    {
                                        "version_added": "66"
                                    }
                                ],
                                "description": "The description for the command.",
                                "optional": true,
                                "type": "string"
                            },
                            "name": {
                                "annotations": [
                                    {
                                        "version_added": "66"
                                    }
                                ],
                                "description": "The name of the command.",
                                "type": "string"
                            },
                            "shortcut": {
                                "annotations": [
                                    {
                                        "version_added": "66"
                                    }
                                ],
                                "description": "An empty string to clear the shortcut, or a string matching the format defined by the <a href='https://developer.mozilla.org/en-US/docs/Mozilla/Add-ons/WebExtensions/manifest.json/commands#shortcut_values'>MDN page of the commands API</a>  to set a new shortcut key. If the string does not match this format, the function throws an error.",
                                "format": "manifestShortcutKeyOrEmpty",
                                "optional": true,
                                "type": "string"
                            }
                        },
                        "type": "object"
                    }
                ],
                "type": "function"
            }
        ],
        "namespace": "commands",
        "permissions": [
            "manifest:commands"
        ],
        "types": [
            {
                "annotations": [
                    {
                        "api_documentation_url": "https://webextension-api.thunderbird.net/en/mv2/commands.html#command"
                    },
                    {
                        "version_added": "66"
                    }
                ],
                "id": "Command",
                "properties": {
                    "description": {
                        "annotations": [
                            {
                                "version_added": "66"
                            }
                        ],
                        "description": "The description of the Extension Command",
                        "optional": true,
                        "type": "string"
                    },
                    "name": {
                        "annotations": [
                            {
                                "version_added": "66"
                            }
                        ],
                        "description": "The name of the Extension Command",
                        "optional": true,
                        "type": "string"
                    },
                    "shortcut": {
                        "annotations": [
                            {
                                "version_added": "66"
                            }
                        ],
                        "description": "The shortcut active for this command, or blank if not active.",
                        "optional": true,
                        "type": "string"
                    }
                },
                "type": "object"
            }
        ]
    }
