        "namespace": "manifest",
        "types": [
            {
                "$extend": "WebExtensionManifest",
                "properties": {
                    "cloud_file": {
                        "additionalProperties": {
                            "$ref": "UnrecognizedProperty"
                        },
                        "annotations": [
                            {
                                "version_added": "64"
                            }
                        ],
                        "description": "Defines a cloud file provider for uploading large attachments to a remote server.",
                        "optional": true,
                        "properties": {
                            "browser_style": {
                                "annotations": [
                                    {
                                        "version_added": "90"
                                    }
                                ],
                                "default": false,
                                "description": "Enable browser styles in the <var>management_url</var> page. See the <a href='https://developer.mozilla.org/en-US/docs/Mozilla/Add-ons/WebExtensions/user_interface/Browser_styles'>MDN documentation on browser styles</a> for more information.",
                                "optional": true,
                                "type": "boolean"
                            },
                            "data_format": {
                                "annotations": [
                                    {
                                        "version_added": "71"
                                    }
                                ],
                                "deprecated": true,
                                "description": "This property is no longer used. The only supported data format for the <var>data</var> argument in $(ref:cloudFile.onFileUpload) is <a href='https://developer.mozilla.org/en-US/docs/Web/API/File'>File</a>.",
                                "optional": true,
                                "type": "string"
                            },
                            "management_url": {
                                "annotations": [
                                    {
                                        "note": "Within this UI only a limited subset of the WebExtension APIs is available: <var>cloudFile</var>, <var>extension</var>, <var>i18n</var>, <var>runtime</var>, <var>storage</var>. The id of the to be configured cloud file account can be retrieved via <code>new URL(location.href).searchParams.get('accountId');</code>."
                                    },
                                    {
                                        "version_added": "64"
                                    }
                                ],
                                "description": "A page for configuring accounts, to be displayed in the preferences UI.",
                                "format": "relativeUrl",
                                "preprocess": "localize",
                                "type": "string"
                            },
                            "name": {
                                "annotations": [
                                    {
                                        "version_added": "64"
                                    }
                                ],
                                "description": "Name of the cloud file service.",
                                "preprocess": "localize",
                                "type": "string"
                            },
                            "new_account_url": {
                                "annotations": [
                                    {
                                        "version_added": "64"
                                    }
                                ],
                                "deprecated": true,
                                "description": "This property was never used.",
                                "optional": true,
                                "type": "string"
                            },
                            "reuse_uploads": {
                                "annotations": [
                                    {
                                        "version_added": "98"
                                    }
                                ],
                                "default": true,
                                "description": "If a previously uploaded cloud file attachment is reused at a later time in a different message, Thunderbird may use the already known <var>url</var> and <var>templateInfo</var> values without triggering the registered $(ref:cloudFile.onFileUpload) listener again. Setting this option to <var>false</var> will always trigger the registered listener, providing the already known values through the <var>relatedFileInfo</var> parameter of the $(ref:cloudFile.onFileUpload) event, to let the provider decide how to handle these cases.",
                                "optional": true,
                                "type": "boolean"
                            },
                            "service_url": {
                                "annotations": [
                                    {
                                        "version_added": "64"
                                    }
                                ],
                                "deprecated": true,
                                "description": "This property is no longer used. The <var>service_url</var> property of the $(ref:cloudFile.CloudFileTemplateInfo) object returned by the $(ref:cloudFile.onFileUpload) event can be used to add a <em>Learn more about</em> link to the footer of the cloud file attachment element.",
                                "optional": true,
                                "type": "string"
                            }
                        },
                        "type": "object"
                    }
                }
            }
        ]
